{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^research-compute:research-compute$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-agent-context.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
